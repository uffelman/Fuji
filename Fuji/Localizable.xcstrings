    "onboardingFeatureMenuBarDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Fuji لا يعيق عملك — بدون أيقونة في Dock، بدون نافذة رئيسية، دائمًا على بُعد نقرة واحدة."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Fuji vám nepřekáží — bez ikony v Dock, bez hlavního okna, vždy na jedno kliknutí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fuji er altid ude af vejen — intet Dock-ikon, intet hovedvindue, altid kun et klik væk."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fuji hält sich im Hintergrund – kein Dock-Symbol, kein Hauptfenster, immer nur einen Klick entfernt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fuji stays out of your way — no Dock icon, no main window, always one click away."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fuji no te estorba: sin icono en el Dock, sin ventana principal, siempre a un clic de distancia."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Fuji pysyy poissa tieltä — ei Dock-kuvaketta, ei pääikkunaa, aina yhden napsautuksen päässä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fuji se fait discret — pas d'icône dans le Dock, pas de fenêtre principale, toujours à un clic."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Fuji לא מפריע לך — ללא סמל ב-Dock, ללא חלון ראשי, תמיד במרחק לחיצה."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Fuji nem zavar — nincs Dock ikon, nincs főablak, mindig egy kattintásra van."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Fuji tidak menghalangi Anda — tanpa ikon Dock, tanpa jendela utama, selalu hanya satu klik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fuji non ti intralcia — nessuna icona nel Dock, nessuna finestra principale, sempre a un clic di distanza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Fujiは邪魔をしません。Dockアイコンもメインウィンドウもなく、いつでもワンクリックで操作できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Fuji는 방해하지 않습니다 — Dock 아이콘도, 메인 윈도우도 없이 항상 한 번의 클릭으로 접근할 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fuji holder seg unna — ingen Dock-ikon, ikke noe hovedvindu, alltid bare et klikk unna."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Fuji zit niet in de weg — geen Dock-pictogram, geen hoofdvenster, altijd één klik verwijderd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Fuji nie przeszkadza — bez ikony w Dock, bez głównego okna, zawsze jedno kliknięcie dalej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Fuji não atrapalha — sem ícone no Dock, sem janela principal, sempre a um clique de distância."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fuji nu vă stă în cale — fără pictogramă în Dock, fără fereastră principală, mereu la un clic distanță."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fuji stör dig inte — ingen Dock-ikon, inget huvudfönster, alltid ett klick bort."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Fuji ไม่รบกวนคุณ — ไม่มีไอคอนใน Dock ไม่มีหน้าต่างหลัก พร้อมให้ใช้งานเสมอแค่คลิกเดียว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fuji aradan çekilir — Dock simgesi yok, ana pencere yok, her zaman bir tık uzağınızda."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Fuji не заважає — без значка в Dock, без головного вікна, завжди на відстані одного кліку."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Fuji không làm phiền bạn — không có biểu tượng Dock, không có cửa sổ chính, luôn chỉ cách một cú nhấp."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Fuji 不会打扰你——没有程序坞图标，没有主窗口，随时一键可达。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Fuji 不會干擾你 — 沒有 Dock 圖示，沒有主視窗，隨時一鍵可達。"
          }
        }
      }
    },
    "onboardingFeatureMenuBarTitle": {
