    "A lightweight menu bar utility for instantly \nswitching display resolutions on macOS.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein schlankes Menüleisten-Dienstprogramm zum sofortigen \nWechseln der Bildschirmauflösung unter macOS."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una utilidad ligera en la barra de menús para cambiar \ninstantáneamente la resolución de pantalla en macOS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un utilitaire léger dans la barre des menus pour changer \ninstantanément la résolution d'écran sur macOS."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOSでディスプレイ解像度を瞬時に\n切り替える軽量メニューバーユーティリティ。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一款轻量级菜单栏工具，可在 macOS 上\n即时切换显示器分辨率。"
          }
        }
      }
    },
