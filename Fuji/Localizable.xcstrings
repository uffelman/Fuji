    "menuDisplaysNotFoundMessage": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر تطبيق الإعداد المسبق '%@' — لا يوجد أي من الشاشات المُعدّة متصلاً حاليًا."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nelze použít předvolbu „%@” — žádný z nakonfigurovaných displejů není momentálně připojen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke anvende forudindstillingen '%@' — ingen af de konfigurerede skærme er i øjeblikket tilsluttet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Voreinstellung „%@“ konnte nicht angewendet werden – keiner der konfigurierten Bildschirme ist derzeit verbunden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not apply preset '%@' — none of the configured displays are currently connected."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo aplicar el preajuste \"%@\": ninguna de las pantallas configuradas está conectada actualmente."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Esiasetusta '%@' ei voitu ottaa käyttöön — yhtään määritetyistä näytöistä ei ole tällä hetkellä yhdistetty."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d'appliquer le préréglage « %@ » — aucun des écrans configurés n'est actuellement connecté."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן להחיל את ההגדרה '%@' — אף אחד מהצגים המוגדרים אינו מחובר כעת."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem sikerült alkalmazni a(z) „%@” előbeállítást — a konfigurált kijelzők közül egyik sincs csatlakoztatva."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat menerapkan preset '%@' — tidak ada layar yang dikonfigurasi saat ini terhubung."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile applicare il preset '%@' — nessuno dei display configurati è attualmente collegato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プリセット「%@」を適用できませんでした — 設定されたディスプレイが現在接続されていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프리셋 '%@'을(를) 적용할 수 없습니다 — 구성된 디스플레이가 현재 연결되어 있지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke bruke forhåndsinnstillingen '%@' — ingen av de konfigurerte skjermene er for øyeblikket tilkoblet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan voorinstelling '%@' niet toepassen — geen van de geconfigureerde beeldschermen is momenteel aangesloten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można zastosować presetu '%@' — żaden ze skonfigurowanych wyświetlaczy nie jest obecnie podłączony."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível aplicar a predefinição '%@' — nenhum dos monitores configurados está conectado no momento."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu s-a putut aplica presetarea „%@” — niciunul dintre ecranele configurate nu este conectat în prezent."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunde inte tillämpa förinställningen '%@' — ingen av de konfigurerade skärmarna är för närvarande anslutna."
          }
        },
