    "onboardingFeaturePresetsDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احفظ تكوينات العرض المفضلة لديك وبدّل بينها بنقرة واحدة من شريط القوائم."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uložte si oblíbené konfigurace displeje a přepínejte mezi nimi jedním kliknutím z řádku nabídek."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gem dine foretrukne skærmkonfigurationer og skift mellem dem med ét klik fra menulinjen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichere deine bevorzugten Bildschirmkonfigurationen und wechsle mit einem Klick in der Menüleiste zwischen ihnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save your go-to display configurations and switch between them in one click from the menu bar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda tus configuraciones de pantalla favoritas y cambia entre ellas con un clic desde la barra de menús."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tallenna suosikkinäyttökokoonpanosi ja vaihda niiden välillä yhdellä napsautuksella valikkopalkista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez vos configurations d'écran préférées et basculez entre elles en un clic depuis la barre des menus."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שמור את תצורות התצוגה המועדפות שלך ועבור ביניהן בלחיצה אחת משורת התפריטים."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mentsd el a kedvenc kijelzőkonfigurációidat, és válts közöttük egyetlen kattintással a menüsorból."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Simpan konfigurasi layar favorit Anda dan beralih di antara mereka dengan satu klik dari bilah menu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva le tue configurazioni di display preferite e passa dall'una all'altra con un clic dalla barra dei menu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "よく使うディスプレイ設定を保存し、メニューバーからワンクリックで切り替えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자주 사용하는 디스플레이 구성을 저장하고 메뉴 막대에서 한 번의 클릭으로 전환하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lagre dine foretrukne skjermkonfigurasjoner og bytt mellom dem med ett klikk fra menylinjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sla je favoriete beeldschermconfiguraties op en wissel ertussen met één klik vanuit de menubalk."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisz ulubione konfiguracje wyświetlacza i przełączaj się między nimi jednym kliknięciem z paska menu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salve suas configurações de tela favoritas e alterne entre elas com um clique na barra de menus."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvați configurațiile de ecran preferate și comutați între ele cu un singur clic din bara de meniuri."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Spara dina favoritkonfigurationer för skärmen och växla mellan dem med ett klick från menyraden."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกการตั้งค่าจอแสดงผลที่ใช้บ่อยและสลับไปมาด้วยคลิกเดียวจากแถบเมนู"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sık kullandığınız ekran yapılandırmalarını kaydedin ve menü çubuğundan tek tıkla aralarında geçiş yapın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зберігайте улюблені конфігурації дисплея та перемикайтеся між ними одним кліком зі смуги меню."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lưu các cấu hình màn hình thường dùng và chuyển đổi giữa chúng chỉ bằng một cú nhấp từ thanh menu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存常用的显示器配置，通过菜单栏一键切换。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "儲存常用的顯示配置，從選單列一鍵切換。"
          }
        }
      }
    },
