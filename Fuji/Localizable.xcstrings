    "onboardingFeatureHotkeysDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عيّن اختصارات لوحة مفاتيح عامة مخصصة لأي إعداد مسبق مسمى حتى تتمكن من الانتقال إلى تكوين محدد دون لمس الماوس."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přiřaďte vlastní globální zkratky k libovolné pojmenované předvolbě, abyste mohli přepnout na konkrétní konfiguraci bez použití myši."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tildel brugerdefinerede globale genveje til enhver navngivet forudindstilling, så du kan skifte til en bestemt konfiguration uden at røre musen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Weise beliebigen Voreinstellungen eigene globale Kurzbefehle zu, um ohne Maus direkt zu einer bestimmten Konfiguration zu springen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Assign custom global shortcuts to any named preset so you can jump to a specific configuration without touching the mouse."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Asigna atajos globales personalizados a cualquier preajuste para saltar a una configuración específica sin tocar el ratón."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Määritä mukautettuja yleisiä pikanäppäimiä mille tahansa nimetylle esiasetukselle, jotta voit siirtyä tiettyyn kokoonpanoon koskematta hiirtä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Attribuez des raccourcis globaux personnalisés à n'importe quel préréglage pour passer à une configuration spécifique sans toucher la souris."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקצה קיצורי דרך גלובליים מותאמים אישית לכל הגדרה מוגדרת מראש כדי שתוכל לעבור לתצורה ספציפית בלי לגעת בעכבר."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Rendelj egyéni globális billentyűkombinációkat bármely elnevezett előbeállításhoz, hogy egérkattintás nélkül válthass egy adott konfigurációra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tetapkan pintasan global khusus ke preset bernama apa pun sehingga Anda dapat beralih ke konfigurasi tertentu tanpa menyentuh mouse."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Assegna scorciatoie globali personalizzate a qualsiasi preset denominato per passare a una configurazione specifica senza toccare il mouse."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "任意のプリセットにカスタムグローバルショートカットを割り当てて、マウスに触れずに特定の設定に切り替えられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이름이 지정된 프리셋에 사용자 정의 전역 단축키를 할당하여 마우스를 사용하지 않고도 특정 구성으로 전환할 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilordne egendefinerte globale snarveier til enhver navngitt forhåndsinnstilling slik at du kan hoppe til en bestemt konfigurasjon uten å ta på musen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wijs aangepaste globale sneltoetsen toe aan elke benoemde voorinstelling zodat je naar een specifieke configuratie kunt springen zonder de muis aan te raken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przypisz niestandardowe globalne skróty do dowolnego nazwanego presetu, aby przełączyć się na wybraną konfigurację bez użycia myszy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Atribua atalhos globais personalizados a qualquer predefinição nomeada para que você possa alternar para uma configuração específica sem tocar no mouse."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Atribuie comenzi rapide globale personalizate oricărei presetări denumite, astfel încât să poți trece la o configurație specifică fără a folosi mouse-ul."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilldela anpassade globala genvägar till valfri namngiven förinställning så att du kan hoppa till en specifik konfiguration utan att röra musen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กำหนดปุ่มลัดทั่วระบบให้กับพรีเซ็ตที่ตั้งชื่อไว้ เพื่อให้คุณสามารถสลับไปยังการตั้งค่าที่ต้องการได้โดยไม่ต้องใช้เมาส์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Herhangi bir adlandırılmış ön ayara özel genel kısayollar atayarak fareye dokunmadan belirli bir yapılandırmaya geçebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Призначте власні глобальні комбінації клавіш для будь-якого набору налаштувань, щоб переходити до потрібної конфігурації без миші."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gán phím tắt toàn cục tùy chỉnh cho bất kỳ thiết lập sẵn nào để bạn có thể chuyển đến cấu hình cụ thể mà không cần dùng chuột."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为任意预设分配自定义全局快捷键，无需动鼠标即可跳转到指定配置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為任何已命名的預設組合指定自訂全域快速鍵，無需使用滑鼠即可跳轉到特定配置。"
          }
        }
      }
    },
