    "presetsSubtitle": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التبديل السريع بين تكوينات العرض باستخدام اختصارات لوحة المفاتيح."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Rychle přepínejte mezi konfiguracemi displeje pomocí klávesových zkratek."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skift hurtigt mellem skærmkonfigurationer med tastaturgenveje."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schnell zwischen Bildschirmkonfigurationen per Tastaturkurzbefehl wechseln."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quick-switch between display configurations using keyboard shortcuts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia rápidamente entre configuraciones de pantalla usando atajos de teclado."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaihda nopeasti näyttökokoonpanojen välillä pikanäppäimillä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Basculez rapidement entre les configurations d'écran à l'aide de raccourcis clavier."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מעבר מהיר בין תצורות תצוגה באמצעות קיצורי מקלדת."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Gyorsan válts a kijelzőkonfigurációk között billentyűkombinációkkal."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Beralih cepat antar konfigurasi layar menggunakan pintasan keyboard."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Passa rapidamente tra le configurazioni del display usando scorciatoie da tastiera."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーボードショートカットでディスプレイ設定をすばやく切り替えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키보드 단축키를 사용하여 디스플레이 구성을 빠르게 전환합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hurtigbytt mellom skjermkonfigurasjoner med hurtigtaster."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schakel snel tussen beeldschermconfiguraties met sneltoetsen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Szybko przełączaj się między konfiguracjami wyświetlacza za pomocą skrótów klawiaturowych."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alterne rapidamente entre configurações de tela usando atalhos de teclado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Comutați rapid între configurațiile de ecran folosind comenzi rapide de la tastatură."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Snabbväxla mellan skärmkonfigurationer med tangentbordsgenvägar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สลับระหว่างการตั้งค่าจอแสดงผลอย่างรวดเร็วด้วยปุ่มลัดคีย์บอร์ด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Klavye kısayollarıyla ekran yapılandırmaları arasında hızla geçiş yapın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Швидко перемикайтеся між конфігураціями дисплея за допомогою комбінацій клавіш."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chuyển đổi nhanh giữa các cấu hình màn hình bằng phím tắt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用键盘快捷键在显示器配置之间快速切换。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
