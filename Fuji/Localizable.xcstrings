    "aboutTipJarText": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ مجاني ومفتوح المصدر.\nإذا وجدته مفيدًا، فكّر في ترك إكرامية! ❤️"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ je zdarma a open source.\nPokud vám přijde užitečný, zvažte, zda nepřispějete! ❤️"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ er gratis og open source.\nHvis du finder det nyttigt, kan du overveje at give et bidrag! ❤️"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist kostenlos und quelloffen.\nWenn du es nützlich findest, hinterlasse gerne ein Trinkgeld! ❤️"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is free and open source.\nIf you find it useful, consider leaving a tip! ❤️"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ es gratuito y de código abierto.\nSi te resulta útil, ¡considera dejar una propina! ❤️"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ on ilmainen ja avoimen lähdekoodin sovellus.\nJos pidät sitä hyödyllisenä, harkitse tipin jättämistä! ❤️"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est gratuit et open source.\nSi vous le trouvez utile, pensez à laisser un pourboire ! ❤️"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ הוא חינמי וקוד פתוח.\nאם מצאת אותו שימושי, שקול להשאיר טיפ! ❤️"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A %@ ingyenes és nyílt forráskódú.\nHa hasznosnak találod, fontold meg, hogy háládat fejezd ki! ❤️"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ bersifat gratis dan open source.\nJika menurut Anda berguna, pertimbangkan untuk memberi tip! ❤️"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ è gratuito e open source.\nSe lo trovi utile, considera di lasciare una mancia! ❤️"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は無料でオープンソースです。\n便利だと感じたら、ぜひチップをお願いします！ ❤️"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@은(는) 무료 오픈 소스입니다.\n유용하다고 생각하시면 팁을 남겨주세요! ❤️"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ er gratis og åpen kildekode.\nHvis du synes det er nyttig, vurder å legge igjen et tips! ❤️"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is gratis en open source.\nAls je het nuttig vindt, overweeg dan een fooi achter te laten! ❤️"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ jest darmowy i ma otwarty kod źródłowy.\nJeśli uważasz go za przydatny, rozważ zostawienie napiwku! ❤️"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ é gratuito e de código aberto.\nSe você achar útil, considere deixar uma gorjeta! ❤️"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ este gratuit și open source.\nDacă îl găsești util, ia în considerare să lași un bacșiș! ❤️"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ är gratis och har öppen källkod.\nOm du tycker det är användbart, överväg att lämna en dricks! ❤️"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ เป็นซอฟต์แวร์ฟรีและโอเพนซอร์ส\nหากคุณพบว่ามีประโยชน์ ลองพิจารณาให้ทิปด้วยนะ! ❤️"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ücretsiz ve açık kaynaklıdır.\nFaydalı buluyorsanız, bahşiş bırakmayı düşünün! ❤️"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — безкоштовний і з відкритим кодом.\nЯкщо вважаєте корисним, залиште подяку! ❤️"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ miễn phí và mã nguồn mở.\nNếu bạn thấy hữu ích, hãy cân nhắc ủng hộ! ❤️"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 是免费的开源软件。\n如果觉得好用，欢迎打赏支持！ ❤️"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 是免費的開源軟體。\n如果覺得好用，歡迎打賞支持！❤️"
          }
        }
      }
    },
