    "onboardingWelcomeSubtitle": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تنقّل بين الدقات في لحظة — أو انتقل إلى إعداد مسبق محفوظ — دون مغادرة سير عملك."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Procházejte rozlišení okamžitě — nebo přeskočte na uloženou předvolbu — aniž byste opustili svou práci."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gå trinvist gennem opløsninger på et øjeblik — eller spring til en gemt forudindstilling — uden at forlade dit workflow."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wechsle Auflösungen im Handumdrehen – oder springe zu einer gespeicherten Voreinstellung – ohne deinen Arbeitsablauf zu unterbrechen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Step through resolutions in an instant — or jump to a saved preset — without leaving your workflow."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia de resolución en un instante, o salta a un preajuste guardado, sin interrumpir tu flujo de trabajo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Selaa tarkkuuksia hetkessä — tai siirry tallennettuun esiasetukseen — poistumatta työnkulustasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Changez de résolution en un instant — ou passez à un préréglage enregistré — sans quitter votre flux de travail."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עבור בין רזולוציות ברגע — או קפוץ להגדרה שמורה — בלי לעזוב את העבודה שלך."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Lépkedj a felbontások között pillanatok alatt — vagy ugorj egy mentett előbeállításra — a munkafolyamat megszakítása nélkül."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Beralih resolusi dalam sekejap — atau langsung ke preset tersimpan — tanpa meninggalkan alur kerja Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scorri le risoluzioni in un istante — o passa a un preset salvato — senza interrompere il tuo flusso di lavoro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "解像度を瞬時に切り替え、保存したプリセットにジャンプ。作業を中断する必要はありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "워크플로를 벗어나지 않고 해상도를 즉시 단계별로 변경하거나 저장된 프리셋으로 이동하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gå gjennom oppløsninger på et øyeblikk — eller hopp til en lagret forhåndsinnstilling — uten å forlate arbeidsflyten din."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stap door resoluties in een oogwenk — of spring naar een opgeslagen voorinstelling — zonder je workflow te verlaten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przejdź przez rozdzielczości w mgnieniu oka — lub przeskocz do zapisanego presetu — bez przerywania pracy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Percorra as resoluções instantaneamente — ou pule para uma predefinição salva — sem interromper seu fluxo de trabalho."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Parcurgeți rezoluțiile instantaneu — sau treceți la o presetare salvată — fără a vă părăsi fluxul de lucru."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Stega genom upplösningar på ett ögonblick — eller hoppa till en sparad förinställning — utan att lämna ditt arbetsflöde."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สลับความละเอียดได้ทันที — หรือข้ามไปยังพรีเซ็ตที่บันทึกไว้ — โดยไม่ต้องออกจากเวิร์กโฟลว์ของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çözünürlükler arasında anında geçin — veya kaydedilmiş bir ön ayara atlayın — iş akışınızdan ayrılmadan."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перемикайте роздільну здатність миттєво — або переходьте до збереженого набору налаштувань — не перериваючи робочий процес."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chuyển đổi độ phân giải ngay lập tức — hoặc nhảy đến thiết lập sẵn đã lưu — mà không rời khỏi quy trình làm việc."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "即时切换分辨率，或跳转到已保存的预设，无需离开当前工作流程。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "瞬間切換解析度 — 或跳轉到已儲存的預設組合 — 無需離開工作流程。"
          }
        }
      }
    },
