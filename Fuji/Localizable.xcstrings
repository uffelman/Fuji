    "Global keyboard shortcuts are active and ready to use.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Globale Tastaturkurzbefehle sind aktiv und einsatzbereit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los atajos de teclado globales están activos y listos para usar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les raccourcis clavier globaux sont actifs et prêts à l'emploi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グローバルキーボードショートカットが有効で、使用可能です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全局键盘快捷键已激活，随时可用。"
          }
        }
      }
    },
    "Global keyboard shortcuts require Accessibility access in System Settings > Privacy & Security > Accessibility.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Globale Tastaturkurzbefehle erfordern die Bedienungshilfen-Berechtigung unter Systemeinstellungen > Datenschutz & Sicherheit > Bedienungshilfen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los atajos de teclado globales requieren acceso de accesibilidad en Ajustes del Sistema > Privacidad y seguridad > Accesibilidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les raccourcis clavier globaux nécessitent l'accès d'accessibilité dans Réglages Système > Confidentialité et sécurité > Accessibilité."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グローバルキーボードショートカットを使用するには、システム設定 > プライバシーとセキュリティ > アクセシビリティでアクセスを許可する必要があります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全局键盘快捷键需要在系统设置 > 隐私与安全性 > 辅助功能中授予权限。"
          }
        }
      }
    },
