    "onboardingPermissionsBody": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختصارات Fuji — بما في ذلك **⌃⌥↑** و **⌃⌥↓** — تحتاج إلى الوصول إلى **تسهيلات الاستخدام** للعمل على مستوى النظام، حتى عندما يكون تطبيق آخر في المقدمة."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zkratky Fuji — včetně **⌃⌥↑** a **⌃⌥↓** — vyžadují přístup k **Přístupnosti**, aby fungovaly celoplošně, i když je jiná aplikace v popředí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fujis genveje — inklusive **⌃⌥↑** og **⌃⌥↓** — kræver **Tilgængeligheds**-adgang for at fungere systemdækkende, selv når en anden app er i fokus."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fujis Kurzbefehle — einschließlich **⌃⌥↑** und **⌃⌥↓** — benötigen **Bedienungshilfen**-Zugriff, um systemweit zu funktionieren, auch wenn eine andere App im Vordergrund ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fuji's shortcuts — including **⌃⌥↑** and **⌃⌥↓** — need **Accessibility** access to work system-wide, even when another app is in focus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los atajos de Fuji — incluyendo **⌃⌥↑** y **⌃⌥↓** — necesitan acceso de **Accesibilidad** para funcionar en todo el sistema, incluso cuando otra app está en primer plano."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Fujin pikanäppäimet — mukaan lukien **⌃⌥↑** ja **⌃⌥↓** — tarvitsevat **Saavutettavuus**-käyttöoikeuden toimiakseen koko järjestelmässä, myös kun toinen sovellus on aktiivisena."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les raccourcis de Fuji — y compris **⌃⌥↑** et **⌃⌥↓** — nécessitent l'accès **Accessibilité** pour fonctionner à l'échelle du système, même lorsqu'une autre app est au premier plan."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קיצורי הדרך של Fuji — כולל **⌃⌥↑** ו-**⌃⌥↓** — צריכים גישת **נגישות** כדי לפעול ברחבי המערכת, גם כשאפליקציה אחרת בפוקוס."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Fuji billentyűkombinációi — beleértve a **⌃⌥↑** és **⌃⌥↓** — **Kisegítő lehetőségek** hozzáférést igényelnek a rendszerszintű működéshez, még ha más alkalmazás van fókuszban."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pintasan Fuji — termasuk **⌃⌥↑** dan **⌃⌥↓** — memerlukan akses **Aksesibilitas** agar berfungsi di seluruh sistem, bahkan saat app lain sedang aktif."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le scorciatoie di Fuji — incluse **⌃⌥↑** e **⌃⌥↓** — richiedono l'accesso all'**Accessibilità** per funzionare a livello di sistema, anche quando un'altra app è in primo piano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Fujiのショートカット（**⌃⌥↑** や **⌃⌥↓** を含む）は、他のアプリがフォーカスされている場合でもシステム全体で機能するために**アクセシビリティ**のアクセス許可が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Fuji의 단축키 — **⌃⌥↑** 및 **⌃⌥↓** 포함 — 는 다른 앱이 포커스되어 있을 때도 시스템 전체에서 작동하려면 **손쉬운 사용** 접근 권한이 필요합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fujis snarveier — inkludert **⌃⌥↑** og **⌃⌥↓** — trenger **Tilgjengelighets**-tilgang for å fungere systemomfattende, selv når en annen app er i fokus."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De sneltoetsen van Fuji — inclusief **⌃⌥↑** en **⌃⌥↓** — hebben **Toegankelijkheids**-toegang nodig om systeembreed te werken, zelfs als een andere app in focus is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Skróty Fuji — w tym **⌃⌥↑** i **⌃⌥↓** — wymagają dostępu do **Dostępności**, aby działać w całym systemie, nawet gdy inna aplikacja jest aktywna."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os atalhos do Fuji — incluindo **⌃⌥↑** e **⌃⌥↓** — precisam de acesso à **Acessibilidade** para funcionar em todo o sistema, mesmo quando outro app está em foco."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Comenzile rapide Fuji — inclusiv **⌃⌥↑** și **⌃⌥↓** — necesită acces la **Accesibilitate** pentru a funcționa la nivel de sistem, chiar și când o altă aplicație este activă."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fujis genvägar — inklusive **⌃⌥↑** och **⌃⌥↓** — behöver **Tillgänglighets**-åtkomst för att fungera systemomfattande, även när en annan app har fokus."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปุ่มลัดของ Fuji — รวมถึง **⌃⌥↑** และ **⌃⌥↓** — ต้องใช้สิทธิ์**การเข้าถึง**เพื่อทำงานทั่วระบบ แม้ในขณะที่แอปอื่นอยู่ในโฟกัส"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fuji'nin kısayolları — **⌃⌥↑** ve **⌃⌥↓** dahil — başka bir uygulama odaktayken bile sistem genelinde çalışmak için **Erişilebilirlik** erişimine ihtiyaç duyar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Комбінації клавіш Fuji — включно з **⌃⌥↑** та **⌃⌥↓** — потребують доступу до **Універсального доступу**, щоб працювати на рівні системи, навіть коли інший застосунок у фокусі."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các phím tắt của Fuji — bao gồm **⌃⌥↑** và **⌃⌥↓** — cần quyền **Trợ năng** để hoạt động trên toàn hệ thống, ngay cả khi ứng dụng khác đang được chọn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Fuji 的快捷键（包括 **⌃⌥↑** 和 **⌃⌥↓**）需要**辅助功能**权限才能在系统范围内工作，即使其他应用处于前台。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Fuji 的快速鍵 — 包括 **⌃⌥↑** 和 **⌃⌥↓** — 需要**輔助使用**權限才能在系統範圍內運作，即使其他 App 處於前景。"
          }
        }
      }
    },
