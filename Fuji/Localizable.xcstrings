    "%lld": {
      "comment": "A numbered label followed by text. The argument is the step number, the second is the text to display.",
      "isCommentAutoGenerated": true
    },
    "aboutDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أداة خفيفة في شريط القوائم للتبديل الفوري \nبين دقة العرض على macOS."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Lehký nástroj v řádku nabídek pro okamžité \npřepínání rozlišení displeje v macOS."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et let menulinjeværktøj til øjeblikkeligt at \nskifte skærmopløsninger på macOS."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein schlankes Menüleisten-Dienstprogramm zum sofortigen \nWechseln der Bildschirmauflösung unter macOS."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A lightweight menu bar utility for instantly \nswitching display resolutions on macOS."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una utilidad ligera en la barra de menús para cambiar \ninstantáneamente la resolución de pantalla en macOS."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kevyt valikkopalkin apuohjelma näytön tarkkuuksien \nvälittömään vaihtamiseen macOS:ssa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un utilitaire léger dans la barre des menus pour changer \ninstantanément la résolution d'écran sur macOS."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כלי קל בשורת התפריטים למעבר מיידי \nבין רזולוציות תצוגה ב-macOS."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Könnyű menüsor segédprogram a kijelzőfelbontás \nazonnali váltásához macOS-en."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilitas bilah menu yang ringan untuk langsung \nberalih resolusi layar di macOS."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un'utility leggera nella barra dei menu per cambiare \nistantaneamente la risoluzione dello schermo su macOS."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOSでディスプレイ解像度を瞬時に\n切り替える軽量メニューバーユーティリティ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS에서 디스플레이 해상도를 즉시 전환할 수 있는 \n가벼운 메뉴 막대 유틸리티입니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Et lett menylinjeverktøy for å umiddelbart \nbytte skjermoppløsninger på macOS."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een lichtgewicht menubalk-hulpprogramma om direct \nbeeldschermresoluties te wisselen op macOS."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lekkie narzędzie na pasku menu do natychmiastowego \nprzełączania rozdzielczości ekranu w macOS."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um utilitário leve na barra de menus para alternar \ninstantaneamente as resoluções de tela no macOS."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Un utilitar ușor pentru bara de meniuri, pentru comutarea \ninstantanee a rezoluțiilor ecranului pe macOS."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett lättviktigt menyradsverktyg för att omedelbart \nväxla skärmupplösningar på macOS."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยูทิลิตี้แถบเมนูขนาดเล็กสำหรับ\nสลับความละเอียดจอแสดงผลบน macOS ได้ทันที"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS'ta ekran çözünürlüklerini anında \ndeğiştirmek için hafif bir menü çubuğu aracı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Легка утиліта смуги меню для миттєвого \nперемикання роздільної здатності дисплея на macOS."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiện ích thanh menu nhẹ để chuyển đổi \nđộ phân giải màn hình trên macOS ngay lập tức."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一款轻量级菜单栏工具，可在 macOS 上\n即时切换显示器分辨率。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輕量級選單列工具，可在 macOS 上\n即時切換顯示器解析度。"
          }
        }
      }
    },
