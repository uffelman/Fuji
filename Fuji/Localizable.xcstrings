    "Could not apply preset '%@' — none of the configured displays are currently connected.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Voreinstellung „%@“ konnte nicht angewendet werden – keiner der konfigurierten Bildschirme ist derzeit verbunden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo aplicar el preajuste \"%@\": ninguna de las pantallas configuradas está conectada actualmente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d'appliquer le préréglage « %@ » — aucun des écrans configurés n'est actuellement connecté."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プリセット「%@」を適用できませんでした — 設定されたディスプレイが現在接続されていません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法应用预设“%@”——当前没有已配置的显示器连接。"
          }
        }
      }
    },
    "Could not apply the preset '%@'. Some display modes may not be available.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Voreinstellung „%@“ konnte nicht angewendet werden. Einige Anzeigemodi sind möglicherweise nicht verfügbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo aplicar el preajuste \"%@\". Algunos modos de pantalla podrían no estar disponibles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d'appliquer le préréglage « %@ ». Certains modes d'affichage peuvent ne pas être disponibles."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プリセット「%@」を適用できませんでした。一部のディスプレイモードが利用できない可能性があります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法应用预设“%@”。某些显示模式可能不可用。"
          }
        }
      }
    },
    "Could not change the display resolution. The selected mode may not be supported.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Bildschirmauflösung konnte nicht geändert werden. Der ausgewählte Modus wird möglicherweise nicht unterstützt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo cambiar la resolución de pantalla. Es posible que el modo seleccionado no sea compatible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de changer la résolution de l'écran. Le mode sélectionné n'est peut-être pas pris en charge."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ディスプレイの解像度を変更できませんでした。選択したモードがサポートされていない可能性があります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法更改显示器分辨率。所选模式可能不受支持。"
          }
        }
      }
    },
    "Could not reset the display to its default resolution.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Bildschirm konnte nicht auf die Standardauflösung zurückgesetzt werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo restablecer la pantalla a su resolución predeterminada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de réinitialiser l'écran à sa résolution par défaut."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ディスプレイをデフォルトの解像度にリセットできませんでした。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法将显示器重置为默认分辨率。"
          }
        }
      }
    },
