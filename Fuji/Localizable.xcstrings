    "Click \"Add Preset\" below to create a new preset": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicke unten auf „Voreinstellung hinzufügen“, um eine neue Voreinstellung zu erstellen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic en \"Agregar preajuste\" a continuación para crear uno nuevo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez sur « Ajouter un préréglage » ci-dessous pour en créer un nouveau"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "下の「プリセットを追加」をクリックして新しいプリセットを作成してください"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击下方的“添加预设”来创建新预设"
          }
        }
      }
    },
    "Click **Open System Settings** below.": {
      "extractionState": "manual",
      "localizations": {
