            "value": "Fuji 设置"
          }
        }
      }
    },
    "Fuji stays out of your way — no Dock icon, no main window, always one click away.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fuji hält sich im Hintergrund – kein Dock-Symbol, kein Hauptfenster, immer nur einen Klick entfernt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fuji no te estorba: sin icono en el Dock, sin ventana principal, siempre a un clic de distancia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fuji se fait discret — pas d'icône dans le Dock, pas de fenêtre principale, toujours à un clic."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Fujiは邪魔をしません。Dockアイコンもメインウィンドウもなく、いつでもワンクリックで操作できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Fuji 不会打扰你——没有程序坞图标，没有主窗口，随时一键可达。"
          }
        }
      }
    },
    "Fuji's shortcuts — including **⌃⌥↑** and **⌃⌥↓** — need **Accessibility** access to work system-wide, even when another app is in focus.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fujis Kurzbefehle — einschließlich **⌃⌥↑** und **⌃⌥↓** — benötigen **Bedienungshilfen**-Zugriff, um systemweit zu funktionieren, auch wenn eine andere App im Vordergrund ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los atajos de Fuji — incluyendo **⌃⌥↑** y **⌃⌥↓** — necesitan acceso de **Accesibilidad** para funcionar en todo el sistema, incluso cuando otra app está en primer plano."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les raccourcis de Fuji — y compris **⌃⌥↑** et **⌃⌥↓** — nécessitent l'accès **Accessibilité** pour fonctionner à l'échelle du système, même lorsqu'une autre app est au premier plan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Fujiのショートカット（**⌃⌥↑** や **⌃⌥↓** を含む）は、他のアプリがフォーカスされている場合でもシステム全体で機能するために**アクセシビリティ**のアクセス許可が必要です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Fuji 的快捷键（包括 **⌃⌥↑** 和 **⌃⌥↓**）需要**辅助功能**权限才能在系统范围内工作，即使其他应用处于前台。"
          }
        }
      }
    },
    "General": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
