    "presetsAccessibilityBody": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتطلب اختصارات لوحة المفاتيح العامة الوصول إلى تسهيلات الاستخدام في إعدادات النظام > الخصوصية والأمان > تسهيلات الاستخدام."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Globální klávesové zkratky vyžadují přístup k Přístupnosti v Nastavení systému > Soukromí a zabezpečení > Přístupnost."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Globale tastaturgenveje kræver Tilgængelighedsadgang i Systemindstillinger > Anonymitet og sikkerhed > Tilgængelighed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Globale Tastaturkurzbefehle erfordern die Bedienungshilfen-Berechtigung unter Systemeinstellungen > Datenschutz & Sicherheit > Bedienungshilfen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Global keyboard shortcuts require Accessibility access in System Settings > Privacy & Security > Accessibility."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los atajos de teclado globales requieren acceso de accesibilidad en Ajustes del Sistema > Privacidad y seguridad > Accesibilidad."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yleiset pikanäppäimet vaativat Saavutettavuuskäyttöoikeuden kohdassa Järjestelmäasetukset > Tietosuoja ja turvallisuus > Saavutettavuus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les raccourcis clavier globaux nécessitent l'accès d'accessibilité dans Réglages Système > Confidentialité et sécurité > Accessibilité."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קיצורי מקלדת גלובליים דורשים גישת נגישות בהגדרות מערכת > פרטיות ואבטחה > נגישות."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A globális billentyűkombinációk Kisegítő lehetőségek hozzáférést igényelnek a Rendszerbeállítások > Adatvédelem és biztonság > Kisegítő lehetőségek menüben."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pintasan keyboard global memerlukan akses Aksesibilitas di Pengaturan Sistem > Privasi & Keamanan > Aksesibilitas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le scorciatoie da tastiera globali richiedono l'accesso all'Accessibilità in Impostazioni di Sistema > Privacy e Sicurezza > Accessibilità."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グローバルキーボードショートカットを使用するには、システム設定 > プライバシーとセキュリティ > アクセシビリティでアクセスを許可する必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전역 키보드 단축키는 시스템 설정 > 개인정보 보호 및 보안 > 손쉬운 사용에서 손쉬운 사용 접근 권한이 필요합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Globale hurtigtaster krever Tilgjengelighetstilgang i Systeminnstillinger > Personvern og sikkerhet > Tilgjengelighet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Globale sneltoetsen vereisen Toegankelijkheidstoegang in Systeeminstellingen > Privacy en beveiliging > Toegankelijkheid."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Globalne skróty klawiaturowe wymagają dostępu do Dostępności w Ustawienia systemowe > Prywatność i ochrona > Dostępność."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os atalhos de teclado globais requerem acesso à Acessibilidade em Ajustes do Sistema > Privacidade e Segurança > Acessibilidade."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Comenzile rapide globale necesită acces la Accesibilitate în Setări sistem > Confidențialitate și securitate > Accesibilitate."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Globala tangentbordsgenvägar kräver Tillgänglighetsåtkomst i Systeminställningar > Integritet och säkerhet > Tillgänglighet."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
