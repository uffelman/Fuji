    "onboardingPermissionNotGrantedBody": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لن تعمل اختصارات لوحة المفاتيح حتى يتم تمكين هذا."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klávesové zkratky nebudou fungovat, dokud toto nebude povoleno."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tastaturgenveje virker ikke, før dette er aktiveret."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tastaturkurzbefehle funktionieren erst, wenn dies aktiviert ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keyboard shortcuts will not work until this is enabled."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los atajos de teclado no funcionarán hasta que se active este permiso."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pikanäppäimet eivät toimi ennen kuin tämä on käytössä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les raccourcis clavier ne fonctionneront pas tant que cette autorisation n'est pas activée."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קיצורי המקלדת לא יפעלו עד שזה יופעל."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A billentyűkombinációk nem működnek, amíg ez nincs engedélyezve."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pintasan keyboard tidak akan berfungsi sampai ini diaktifkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le scorciatoie da tastiera non funzioneranno finché non saranno abilitate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この設定を有効にするまで、キーボードショートカットは機能しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키보드 단축키는 이 기능이 활성화될 때까지 작동하지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hurtigtaster fungerer ikke før dette er aktivert."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sneltoetsen werken pas als dit is ingeschakeld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Skróty klawiaturowe nie będą działać, dopóki to nie zostanie włączone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os atalhos de teclado não funcionarão até que isso seja ativado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Comenzile rapide de la tastatură nu vor funcționa până când nu este activat."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tangentbordsgenvägar fungerar inte förrän detta är aktiverat."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปุ่มลัดจะไม่ทำงานจนกว่าจะเปิดใช้งาน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu etkinleştirilene kadar klavye kısayolları çalışmayacaktır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Комбінації клавіш не працюватимуть, поки це не ввімкнено."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phím tắt sẽ không hoạt động cho đến khi được bật."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用此权限前，键盘快捷键将无法使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在啟用此選項之前，鍵盤快速鍵將無法使用。"
          }
        }
      }
    },
