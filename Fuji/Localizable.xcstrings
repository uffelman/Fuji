    "onboardingStep4": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عُد إلى هنا — يتم تحديث حالة الإذن تلقائيًا."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vraťte se sem — stav oprávnění se aktualizuje automaticky."
