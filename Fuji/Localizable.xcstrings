            "state": "translated",
            "value": "Globale sneltoetsen zijn actief en klaar voor gebruik."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Globalne skróty klawiaturowe są aktywne i gotowe do użycia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os atalhos de teclado globais estão ativos e prontos para uso."
          }
