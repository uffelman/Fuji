    "onboardingPermissionGrantedBody": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختصارات لوحة المفاتيح العامة نشطة وجاهزة للاستخدام."
          }
        },
        "cs": {
